# --- Режим запуска ---
# demo — синтетические данные (без внешних ключей и интернета)
# real — реальные источники (нужны Google OAuth и файлы организаторов)
MGTS_DATA_MODE=demo

# --- База данных (по умолчанию backend/data/mgts.db) ---
# MGTS_DB_URL=sqlite:///C:/path/to/mgts.db

# --- Синхронизация Google Forms (WP4) ---
# Путь к файлу client secrets OAuth. Файл НЕ коммитится.
# MGTS_GOOGLE_CLIENT_SECRETS_FILE=C:/secrets/google_forms_client_secrets.json
# Переопределение интервала (иначе — из config/sources_forms.yaml)
# MGTS_SYNC_INTERVAL_SEC=120

# --- LLM, этап 2 / WP9 (OpenAI-совместимый API; без ключа — лексиконный fallback) ---
MGTS_LLM_API_KEY=
MGTS_LLM_BASE_URL=https://api.openai.com/v1
MGTS_LLM_MODEL=gpt-4o-mini
MGTS_LLM_TIMEOUT=20
